<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildPlan Model Preview.

  Declares no permissions on purpose. The viewer reads scene bundles that ship
  inside the APK: it needs no network, no storage, no location and no camera,
  and it works with the phone in flight mode.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.BuildPlanPreview">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="fullUser"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BuildPlanPreview">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
