{
  "name": "buildapp",
  "version": "0.1.0",
  "private": true,
  "description": "BuildApp — BuildWorld semantic building editor, Building DSL and geometry compiler",
  "type": "module",
  "workspaces": [
    "tests/architecture",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm run build --workspace apps/web",
    "dev": "npm run dev --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "e2e": "npm run build --workspace apps/web && playwright test -c apps/web/playwright.config.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run e2e",
    "audit:marcowki": "vite-node packages/reference-marcowki/scripts/audit.ts",
    "audit:marcowki:facades": "vite-node packages/reference-marcowki/scripts/audit-facades.ts",
    "mobile:export-scenes": "vite-node packages/mobile-scene/scripts/export-scenes.ts",
    "android:test": "npm run test --workspace apps/android",
    "android:assembleDebug": "npm run assembleDebug --workspace apps/android"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
