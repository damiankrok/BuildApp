+
+// 005Q-CHAIN C1 INK-FIRST (research only). The ink of one label as the frozen ensemble read it, when it is a corroborated
+// reading: AGREES (both readers) or LEADS (the external reader, corroborating), class CLEAR/SUPPORTED, an integer of 2-5
+// digits without a leading zero. Nothing here sees a scale, a chain or a published figure.
+export type InkC1 = { valueCm: number; text: string; decision: string; latticeId: string }
+export function inkOfC1(held: { id: string; lattice: LabelLattice } | undefined): InkC1 | undefined {
+  const e = held?.lattice.ensemble
+  if (!held || !e) return undefined
+  if (e.decision !== 'AGREES' && e.decision !== 'LEADS') return undefined
+  if (e.ocrClass !== 'CLEAR' && e.ocrClass !== 'SUPPORTED') return undefined
+  if (!/^[1-9]\d{1,4}$/.test(e.asRead) || e.asReadValueCm === undefined) return undefined
+  return { valueCm: e.asReadValueCm, text: e.asRead, decision: e.decision, latticeId: held.id }
+}
+/** Research telemetry of the C1 rule (never sealed): evidence id -> what the scale chose and what the ink read. */
+export const inkFirstC1 = new Map<string, { scaleChosenCm: number; scaleChosenText: string; ink: InkC1 }>()
