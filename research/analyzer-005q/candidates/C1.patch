+/**
+ * 005Q (C1): one exterior wall is one body edge, on its outer face.
+ *
+ * A dimension chain that ticks on both faces of an exterior wall, and a band reader that splits a wall in two, put two
+ * grid lines a wall's thickness apart on one wall. What happens next depends on how far apart they happen to be: closer
+ * than a cell, thinning keeps the better-supported one — the INNER face whenever the band's axis claim fell to it — and
+ * the envelope snaps onto it; farther, both stay, the wall becomes a cell row of its own and is dropped as a sliver.
+ * Either way the wall's thickness is lost from the building on that side. So, before thinning, the two are made one
+ * line on the outer face, carrying both lines' probes and support, when the drawing evidences all of it:
+ *  - the outer line is the outermost line on its axis, on that side, and a dimension chain ticks on it;
+ *  - one long, wall-thick band lies between the two lines with its two faces on them (a wall, not a partition or a mark);
+ *  - that side of the building is one continuous wall: wall-thick bands with their outer face on that line cover at
+ *    least `OUTER_FACE_BOUNDS.sideCover` of the extent's span across it. A stepped facade — a set-back niche, a porch,
+ *    a garage door between piers — keeps its lines as they are: one line per side cannot say where each piece stands.
+ * The result does not depend on the cell size: the same wall ends as one line on its outer face at any spacing of its
+ * faces. Where thinning would already keep the outer face and hand it the inner one's probes, nothing is done.
+ */
+export const OUTER_FACE_BOUNDS = { sideCover: 0.75 } as const
+function outerFacePairs(lines: readonly GridLine[], bands: readonly Band[], axis: 'X' | 'Y', wallPx: number, snapPx: number, extent: PixelRect, minCellPx: number): GridLine[] {
