+  const across = (b: Band): [number, number] => (vertical ? [b.bounds.x0, b.bounds.x1] : [b.bounds.y0, b.bounds.y1])
+  const along = (b: Band): [number, number] => (vertical ? [b.bounds.y0, b.bounds.y1] : [b.bounds.x0, b.bounds.x1])
+  const window = (b: Band): number => Math.max(snapPx, b.thickness * 0.35)
+  const [s0, s1] = vertical ? [extent.y0, extent.y1] : [extent.x0, extent.x1]
+  let out = [...lines].sort((a, b) => a.px - b.px)
+  for (const low of [true, false]) {
+    const outer = low ? out[0] : out[out.length - 1]
+    if (!outer || outer.support.chainIds.length === 0) continue
+    const pair = walls
+      .filter((b) => b.length >= wallPx * 2.5)
+      .map((b) => {
+        const [f0, f1] = across(b)
+        const [o, i] = low ? [f0, f1] : [f1, f0]
+        if (Math.abs(o - outer.px) > window(b)) return undefined
+        const inner = out.find((l) => l !== outer && Math.abs(l.px - i) <= window(b) && (low ? l.px > outer.px : l.px < outer.px))
+        return inner
