+        chainSpanPx: Math.max(outer.support.chainSpanPx, pair.support.chainSpanPx),
+        bandLength: round6(outer.support.bandLength + pair.support.bandLength),
+        bandCoverage: round6(Math.min(1, outer.support.bandCoverage + pair.support.bandCoverage)),
+        bandSpans: outer.support.bandSpans || pair.support.bandSpans,
+      },
+      confidence: Math.max(outer.confidence, pair.confidence),
+      why: `${outer.why}; the same wall's inner face ${round6(Math.abs(pair.px - outer.px))} px in is this line too: one exterior wall, one edge on its outer face (005Q)`,
+    }
