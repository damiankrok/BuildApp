@@ -0,0 +1,93 @@
+/**
+ * BUILDPLAN-ANALYZER-005V-N3: the plan's glazing symbol decides a gap's kind when nothing reads its heights.
+ *
+ * Plans draw a window's frame and glass as thin grey lines across the gap, lighter than wall ink; a door leaves at most
+ * a threshold line and draws its leaf's swing in the room. Two bugs hid the glazing: only ink darker than luma 160
+ * counted, and the scan along the wall started at the smaller of the gap's x and y coordinates, so a gap lying further
+ * across the sheet than down it was scanned from its row number. Synthetic sheets only; no drawing of any real building.
+ */
+import { describe, expect, it } from 'vitest'
+import { readWallOpenings } from '../src/index.js'
+import type { OpeningReadingInput, PlanFrameV2, WallHost } from '../src/index.js'
+
+const MPP = 0.02
+const O = 20
+const OY = 400
+const W = 760
+const H = 520
+const px = (x: number, z: number) => ({ x: O + x / MPP, y: OY + z / MPP })
+type Gap = { from: number; to: number; lines?: Array<{ row: number; luma: number }>; swing?: boolean }
+
+/** A 14 m front wall, 0.4 m thick (rows 400..420), with gaps; room inside below row 420. */
+function sheet(gaps: Gap[]): { raster: OpeningReadingInput['planRaster']; plan: PlanFrameV2 } {
+  const data = new Uint8ClampedArray(W * H * 4).fill(255)
+  const set = (x: number, y: number, l: number): void => {
+    const o = (Math.round(y) * W + Math.round(x)) * 4
+    data[o] = data[o + 1] = data[o + 2] = l
+  }
+  const inGap = (x: number): boolean => gaps.some((g) => x >= px(g.from, 0).x && x <= px(g.to, 0).x)
+  for (let y = px(0, 0).y; y <= px(0, 0.4).y; y += 1) for (let x = px(0, 0).x; x <= px(14, 0).x; x += 1) if (!inGap(x)) set(x, y, 0)
+  for (const g of gaps) {
+    for (const line of g.lines ?? []) for (let x = px(g.from, 0).x; x <= px(g.to, 0).x; x += 1) set(x, line.row, line.luma)
+    if (g.swing) {
+      // a quarter circle of the leaf's width, hinged at the gap's left jamb, inside the room
+      const r = (g.to - g.from) / MPP
+      const cx = px(g.from, 0).x
+      const cy = px(0, 0.4).y + 2
+      for (let a = 0; a <= 90; a += 0.5) set(cx + r * Math.cos((a * Math.PI) / 180), cy + r * Math.sin((a * Math.PI) / 180), 60)
+      for (let y = cy; y <= cy + r; y += 1) set(cx + 1, y, 60)
+    }
+  }
+  const plan: PlanFrameV2 = { frameId: 'frame-plan', assetId: 'asset-plan', storeyIndex: 0, mppX: MPP, mppY: MPP, originPx: { x: O, y: OY }, why: 'synthetic', toWorld: (x, y) => ({ x: (x - O) * MPP, z: (y - OY) * MPP }), toPixel: (x, z) => px(x, z), wallPx: 0.2 / MPP }
+  return { raster: { width: W, height: H, data }, plan }
+}
+const host: WallHost = { massId: 'main', facade: 'FRONT', planeAt: 0, from: 0, to: 14, centreAt: 0.2, storeyIndex: 0, floorY: 0, storeyHeightM: 2.8 }
+const read = (gaps: Gap[]) => {
+  const { raster, plan } = sheet(gaps)
+  return readWallOpenings({ plan, planRaster: raster, host, wallThicknessM: 0.4, callouts: [], views: [], attachedSingleStorey: false, index: 0 })
+}
+/** Glazing as many plans draw it: frame and glass lines in light grey across the wall band. */
+const lightGlazing = [{ row: 404, luma: 199 }, { row: 410, luma: 199 }, { row: 416, luma: 195 }]
+/** A threshold: one line where the floor meets the paper. */
+const threshold = [{ row: 404, luma: 187 }]
+
+describe('005V-N3 the glazing symbol on the plan (no callout, no elevation)', () => {
+  it('light grey glazing lines across a door-wide ground-storey gap make it a window, not a door (red before)', () => {
+    const [o] = read([{ from: 9, to: 10, lines: lightGlazing }])
+    expect(o.family).toBe('WINDOW')
+    expect(o.provenance.family).toBe('ASSUMED_FOR_RENDERING')
+    expect(o.provenance.sill).toBe('ASSUMED_FOR_RENDERING')
+    expect(o.unresolved.some((u) => u.startsWith('kind (glazing drawn'))).toBe(true)
+  })
+
+  it('a threshold line alone is no glazing: the empty ground-storey gap stays a door by the plan convention', () => {
+    const [o] = read([{ from: 9, to: 10, lines: threshold }])
+    expect(o.family).toBe('DOOR')
+    expect(o.sillY).toBe(0)
+  })
+
+  it('glazing and a drawn swing make a glazed door: kind read from both symbols, door heights assumed (red before)', () => {
+    const [o] = read([{ from: 9, to: 10, lines: lightGlazing, swing: true }])
+    expect(o.family).toBe('GLAZED_DOOR')
+    expect(o.provenance.family).toBe('SOURCE_DERIVED')
+    expect(o.sillY).toBe(0)
+    expect(o.headY).toBeCloseTo(2.1, 6)
+    expect(o.provenance.head).toBe('ASSUMED_FOR_RENDERING')
+  })
+
+  it('a swing without glazing stays a plain door', () => {
+    const [o] = read([{ from: 9, to: 10, lines: threshold, swing: true }])
+    expect(o.family).toBe('DOOR')
+  })
+
+  it('dark glazing on a gap further across the sheet than down it is scanned along the gap, not from its row number (red before)', () => {
+    const [o] = read([{ from: 9, to: 10, lines: [{ row: 410, luma: 40 }] }])
+    expect(o.family).toBe('WINDOW')
+  })
+
+  it('a wide glazed screen with nothing read stays a window placeholder (never a full-height screen without a height read)', () => {
+    const [o] = read([{ from: 9, to: 11.6, lines: lightGlazing }])
+    expect(o.family).toBe('WINDOW')
+    expect(o.sillY).toBeCloseTo(0.9, 6)
+  })
+})
