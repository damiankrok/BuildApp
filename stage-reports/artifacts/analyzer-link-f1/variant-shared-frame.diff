+  const ladderX = base.ladders?.x
+  const ladderZ = base.ladders?.z
+  const baseToWorld = (px: number, py: number): { x: number; z: number } => ({
+    x: round6(ladderX ? ladderX.at(px) : (px - base.originPx.x) * baseMppX),
+    z: round6(world.zFlip - (ladderZ ? ladderZ.at(py) : (py - base.originPx.y) * baseMppY)),
+  })
+  const baseToPixel = (x: number, z: number): { x: number; y: number } => ({
+    x: round6(ladderX ? ladderX.px(x) : base.originPx.x + x / baseMppX),
