   const facesY = extent && basePlan ? outerFacesAlong(basePlan.bands, 'Y', extent.y0, extent.y1) : undefined
   const baseMppX = extent ? faceToFaceMetresPerPixel(base.x, extent.x0, extent.x1, facesX, base.metresPerPixelX) : base.metresPerPixelX
   const baseMppY = extent ? faceToFaceMetresPerPixel(base.z, extent.y0, extent.y1, facesY, base.metresPerPixelY) : base.metresPerPixelY
+  // LINK-F1: the base plan's pixels go to metres through the SAME ladders the 03R layout placed the bodies with, so a
+  // wall, a gap, an opening, a stair or a partition read off this sheet lands where the body it belongs to was put. A
+  // linear map here beside the ladder there was two frames for one sheet: they parted by up to 0.17 m on the sealed
+  // houses, and every object read through the linear one stood off its body by that much. Without ladders (a frame
